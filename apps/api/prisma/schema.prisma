// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  name                   String?
  passwordHash           String?
  avatarUrl              String?
  emailVerified          DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  subscriptionTier       SubscriptionTier @default(FREE)
  subscriptionExpiresAt  DateTime?
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique

  preferences            Json      @default("{}")
  
  contentItems           ContentItem[]
  tags                   Tag[]
  connections            Connection[]
  summaries              Summary[]
  voiceProfiles          VoiceProfile[]
  audioSummaries         AudioSummary[]
  conversations          Conversation[]
  chatMessages           ChatMessage[]
  quizzes                Quiz[]
  quizAttempts           QuizAttempt[]
  reviewCards            ReviewCard[]
  exports                ExportJob[]
  imports                ImportJob[]
  webhookEvents          WebhookEvent[]

  @@index([email])
  @@index([subscriptionTier])
}

model ContentItem {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  url             String?          @unique
  sourceType      ContentSourceType
  sourceId        String?
  status          ContentStatus    @default(PENDING)
  rawContent      String?          @db.Text
  summary         String?          @db.Text
  keyPoints       String[]
  metadata        Json             @default("{}")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  processedAt     DateTime?
  errorMessage    String?

  tags            Tag[]            @relation("ContentItemTags")
  connectionsFrom Connection[]     @relation("SourceConnections")
  connectionsTo   Connection[]     @relation("TargetConnections")
  summaries       Summary[]
  quizzes         Quiz[]
  reviewCards     ReviewCard[]

  @@index([userId])
  @@index([sourceType])
  @@index([status])
  @@index([createdAt])
  @@index([userId, status])
  @@index([userId, sourceType])
}

model Tag {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  color            String       @default("#3B82F6")
  count            Int          @default(0)
  createdAt        DateTime     @default(now())
  isAutoGenerated  Boolean      @default(false)

  contentItems     ContentItem[] @relation("ContentItemTags")

  @@unique([userId, name])
  @@index([userId])
  @@index([count])
}

model Connection {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceContentId   String
  sourceContent     ContentItem      @relation("SourceConnections", fields: [sourceContentId], references: [id], onDelete: Cascade)
  targetContentId   String
  targetContent     ContentItem      @relation("TargetConnections", fields: [targetContentId], references: [id], onDelete: Cascade)
  type              ConnectionType
  strength          Float            @default(0)
  description       String?
  createdAt         DateTime         @default(now())

  @@unique([sourceContentId, targetContentId, type])
  @@index([userId])
  @@index([sourceContentId])
  @@index([targetContentId])
}

model Summary {
  id              String       @id @default(cuid())
  contentItemId   String
  contentItem     ContentItem  @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  text            String       @db.Text
  keyPoints       String[]
  model           String
  provider        String
  tokensUsed      Int
  createdAt       DateTime     @default(now())

  audioSummaries  AudioSummary[]

  @@index([contentItemId])
  @@index([userId])
  @@index([createdAt])
}

model VoiceProfile {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  provider    VoiceProvider
  voiceId     String
  sampleUrl   String?
  isDefault   Boolean        @default(false)
  createdAt   DateTime       @default(now())

  audioSummaries AudioSummary[]

  @@index([userId])
}

model AudioSummary {
  id              String        @id @default(cuid())
  summaryId       String
  summary         Summary       @relation(fields: [summaryId], references: [id], onDelete: Cascade)
  voiceProfileId  String
  voiceProfile    VoiceProfile  @relation(fields: [voiceProfileId], references: [id], onDelete: Cascade)
  audioUrl        String
  duration        Int
  status          AudioStatus   @default(GENERATING)
  createdAt       DateTime      @default(now())

  @@index([summaryId])
  @@index([voiceProfileId])
  @@index([status])
}

model Conversation {
  id                String       @id @default(cuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  model             String
  provider          String
  systemPrompt      String?
  contextContentIds String[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  messages          ChatMessage[]

  @@index([userId])
  @@index([updatedAt])
}

model ChatMessage {
  id              String       @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            MessageRole
  content         String       @db.Text
  model           String?
  provider        String?
  tokensUsed      Int?
  citations       Json         @default("[]")
  createdAt       DateTime     @default(now())

  @@index([conversationId])
  @@index([userId])
  @@index([createdAt])
}

model Quiz {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentItemId String
  contentItem ContentItem       @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  title       String
  questions   Json              @default("[]")
  schedule    Json              @default("{}")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  attempts    QuizAttempt[]
  reviewCards ReviewCard[]

  @@index([userId])
  @@index([contentItemId])
  @@index([createdAt])
}

model QuizAttempt {
  id          String      @id @default(cuid())
  quizId      String
  quiz        Quiz        @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers     Json        @default("[]")
  score       Float
  timeSpent   Int
  completedAt DateTime    @default(now())

  @@index([quizId])
  @@index([userId])
  @@index([completedAt])
}

model ReviewCard {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentItemId   String
  contentItem     ContentItem     @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  quizId          String?
  quiz            Quiz?           @relation(fields: [quizId], references: [id], onDelete: SetNull)
  questionId      String?
  schedule        Json            @default("{}")
  state           ReviewState     @default(NEW)
  dueAt           DateTime

  @@index([userId])
  @@index([dueAt])
  @@index([state])
  @@index([userId, state, dueAt])
}

model ExportJob {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  format      ExportFormat
  status      JobStatus     @default(PENDING)
  downloadUrl String?
  fileSize    Int?
  expiresAt   DateTime?
  errorMessage String?
  createdAt   DateTime      @default(now())
  completedAt DateTime?

  @@index([userId])
  @@index([status])
}

model ImportJob {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  format          ImportFormat
  status          JobStatus     @default(PENDING)
  totalItems      Int           @default(0)
  processedItems  Int           @default(0)
  failedItems     Int           @default(0)
  errorMessage    String?
  createdAt       DateTime      @default(now())
  completedAt     DateTime?

  @@index([userId])
  @@index([status])
}

model WebhookEvent {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          WebhookEventType
  payload       Json
  processedAt   DateTime?
  retryCount    Int       @default(0)
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([type])
  @@index([processedAt])
}

// Enums
enum SubscriptionTier {
  FREE
  PRO
  ENTERPRISE
}

enum ContentSourceType {
  YOUTUBE
  PODCAST
  PDF
  ARTICLE
  WIKIPEDIA
  RECIPE
  TIKTOK
  NOTE
  TWITTER
  LINKEDIN
  REDDIT
  GENERIC
}

enum ContentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ConnectionType {
  SEMANTIC
  REFERENCE
  SEQUENCE
  AUTHOR
  TAG
  TEMPORAL
  USER
}

enum VoiceProvider {
  ELEVENLABS
  OPENAI
  LOCAL
}

enum AudioStatus {
  GENERATING
  COMPLETED
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ReviewState {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

enum ExportFormat {
  MARKDOWN
  JSON
  CSV
  PDF
}

enum ImportFormat {
  MARKDOWN
  JSON
  OPML
  CSV
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum WebhookEventType {
  CONTENT_CREATED
  CONTENT_UPDATED
  CONTENT_DELETED
  CONTENT_PROCESSED
  SUMMARY_CREATED
  QUIZ_CREATED
  QUIZ_COMPLETED
  USER_SUBSCRIPTION_CHANGED
  EXPORT_COMPLETED
}